{% extends "layout.njk" %}

{% set title = 'Statistics dashboard' %}
{% set primaryNavId = 'statistics' %}
{% set statsTab = statsTab or 'overview' %}
{% set listingCount = jobCount or (user.jobs | length) %}

{% block content %}
  <h1 class="govuk-heading-l">Statistics dashboard</h1>

  <p class="govuk-body">This may include equal opportunities data from people who have withdrawn their applications. We include this to help keep the data anonymous.</p>

  {{ appSubNavigation({
    classes: 'govuk-!-margin-top-4 govuk-!-margin-bottom-6',
    navigationLabel: 'Statistics',
    items: [{
      html: 'Overview',
      href: '/statistics',
      active: statsTab == 'overview'
    }, {
      html: 'Equal opportunities',
      href: '/statistics/equal-opportunities',
      active: statsTab == 'equal-opportunities'
    }]
  }) }}

  <p class="govuk-body">This data is from the current academic year. If a job is live in two academic years (for example from August 2025 to September 2025) it will be counted for both academic years. This data resets each academic year.</p>

  {% if statsTab == 'overview' %}
    <p class="govuk-body">
      <a class="govuk-link" href="/jobs">View your {{ listingCount }} job listings from this academic year</a>
    </p>
    <p class="govuk-body">Download all historical job listing data as a CSV.</p>
    {{ govukButton({
      text: "Download statistics (CSV, 0.2 KB)",
      classes: "govuk-button--secondary",
      href: "#"
    }) }}

    <h2 class="govuk-heading-m">Job listing source</h2>
    {{ govukButton({
      text: "Show data as a table",
      classes: "govuk-button--secondary"
    }) }}
    <p class="app-statistics-empty">No data</p>
  {% else %}
    <p class="govuk-body">You have received 0 applications this academic year.</p>
    <p class="govuk-body">Download all historical equal opportunities data as a CSV.</p>
    {{ govukButton({
      text: "Download statistics (CSV, 0.2 KB)",
      classes: "govuk-button--secondary",
      href: "#"
    }) }}

    <h2 class="govuk-heading-m">Applicant age</h2>
    {{ govukButton({
      text: "Show data as a table",
      classes: "govuk-button--secondary"
    }) }}
    <p class="app-statistics-empty">No data</p>

    <h2 class="govuk-heading-m">Disability</h2>
    {{ govukButton({
      text: "Show data as a table",
      classes: "govuk-button--secondary"
    }) }}
    <p class="app-statistics-empty">No data</p>
  {% endif %}
{% endblock %}
