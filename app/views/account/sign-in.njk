
{% extends "layout.njk" %}

{% set heading = 'Sign in' %}

{% set title = heading %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <h1 class="govuk-heading-l">
        {{heading}}
      </h1>

      {% if error %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: [
            {
              text: error,
              href: "#emailAddress"
            }
          ]
        }) }}
      {% endif %}

      <form method="post">
        {% if query.returnUrl %}
          <input type="hidden" name="returnUrl" value="{{ query.returnUrl }}">
        {% endif %}

        {{ govukInput({
          label: {
            text: "Email address",
            classes: "govuk-label--m"
          },
          id: "emailAddress",
          name: "emailAddress",
          type: "email",
          autocomplete: "email",
          spellcheck: false,
          value: emailAddress,
          errorMessage: {
            text: error
          } if error
        }) }}

        {{ govukInput({
          id: "password",
          name: "password",
          label: {
            text: "Password",
            classes: "govuk-label--m"
          },
          type: "password"
        }) }}

        {{ govukButton({
          text: "Sign in"
        }) }}




      </form>




    </div>
  </div>

{% endblock %}
