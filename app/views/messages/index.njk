{% extends "layout.njk" %}

{% set title = 'Messages' %}
{% set primaryNavId = 'messages' %}

{% block content %}
  <span class="govuk-caption-xl">{{ user.organisation.name }}</span>
  <h1 class="govuk-heading-l">Messages</h1>

  <p class="govuk-body">Emails sent from your organisation to candidates.</p>

  {% if messages.length %}
    <table class="govuk-table">
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th scope="col" class="govuk-table__header">Candidate</th>
          <th scope="col" class="govuk-table__header">Subject</th>
          <th scope="col" class="govuk-table__header">Sent</th>
          <th scope="col" class="govuk-table__header">Status</th>
        </tr>
      </thead>
      <tbody class="govuk-table__body">
        {% for message in messages %}
          <tr class="govuk-table__row">
            <td class="govuk-table__cell">
              <a class="govuk-link" href="{{ message.href }}">{{ message.name }}</a>
            </td>
            <td class="govuk-table__cell">{{ message.subject }}</td>
            <td class="govuk-table__cell">{{ message.sentOn }}</td>
            <td class="govuk-table__cell">
              {{ govukTag({
                text: message.status,
                classes: "govuk-tag--blue" if message.status == "Opened" else "govuk-tag--grey"
              }) }}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% else %}
    <p class="govuk-body">You have not sent any messages yet.</p>
  {% endif %}
{% endblock %}
