
{% extends "layout.njk" %}

{% set title = 'School profile' %}

{% set primaryNavId = 'organisation' %}

{% block beforeContent %}
  {{ govukBreadcrumbs({
    items: [
      {
        href: '/organisation',
        text: 'Organisation profile'
      },
      {
        text: title
      }
    ]
  }) }}
{% endblock %}

{% block content %}

  {{ govukNotificationBanner({
    html: "<h2 class=\"govuk-heading-m\">"+flash+"</h2>",
    type: "success",
    icon: false
  }) if flash and flash.length }}

  {% if showCompleteProfileBanner and not flash.length %}
    {{ govukNotificationBanner({
      text: "Complete your school profile"
    }) }}
  {% endif %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

      <div class="app-page-header govuk-!-margin-bottom-6">
        <div class="app-page-header__title">
          <h1 class="govuk-heading-l govuk-!-margin-bottom-0">{{ title }}</h1>
        </div>
        <div class="app-page-header__actions">
          <a class="govuk-link" href="/organisation/{{ organisation.id }}/preview">Preview school profile</a>
        </div>
      </div>

      {{appSchoolSummaryList({ organisation: organisation })}}

    </div>
  </div>

{% endblock %}
