{% set homepage = true %}
{% set bodyClasses = "app-homepage" %}
{% set title = "Teaching Vacancies Service" %}

{% extends "layout.njk" %}

{% set schoolUser = "?userEmailAddress=rachael@courtland.sch.uk" %}
{% set collegeUser = "?userEmailAddress=bob@hopecollege.sch.uk" %}

{% macro prototypeItem(href, title, meta) %}
  <li class="app-prototype-list__item">
    <div class="app-prototype-list__icon" aria-hidden="true">
      {{ caller() }}
    </div>
    <div class="app-prototype-list__text">
      <h3 class="app-prototype-list__title">
        <a class="govuk-link" href="{{ href }}">{{ title }}</a>
      </h3>
      <p class="app-prototype-list__meta">{{ meta }}</p>
    </div>
  </li>
{% endmacro %}

{% block header %}
  {% include "includes/header.njk" %}
  <div class="homepage-header">
    <div class="govuk-width-container">
      <span class="homepage-header__caption">Hiring staff prototype</span>
      <h1 class="homepage-header__title">Teaching Vacancies<br>Service</h1>
      <p class="homepage-header__lede">Manage teaching jobs</p>
      <p class="homepage-header__link">
        <a href="https://teaching-vacancies-prototype.herokuapp.com/">Jobseeker prototype</a>
        <svg class="homepage-header__external" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="#ffffff" aria-hidden="true">
          <path d="M9 2h5v5h-1.5V4.56L7.28 9.78 6.22 8.72 11.44 3.5H9V2z"/>
          <path d="M4 3.5h3V5H5.5v7.5h7.5V11H14v3H4z"/>
        </svg>
      </p>
    </div>
  </div>
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full app-prototype-index-column">
      <section class="app-prototype-index">
        <div class="app-prototype-index__heading-row">
          <h2 class="govuk-heading-m app-prototype-index__heading">Current version</h2>
          <p class="app-prototype-index__updated">Last updated: 7 October 2026</p>
        </div>
        <ul class="app-prototype-list">
          {% call prototypeItem("/start", "Sign in to manage teaching jobs", "The hiring staff start page, sign in, and request an account.") %}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#1d70b8" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="8" r="3.25"/><path d="M5.5 19.25c.8-3.2 3-5 6.5-5s5.7 1.8 6.5 5"/></svg>
          {% endcall %}
          {% call prototypeItem("/jobs" + schoolUser, "View signed in", "Open the prototype as a signed-in hiring staff user at Courtland Primary School.") %}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#1d70b8" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="8" r="3.25"/><path d="M5.5 19.25c.8-3.2 3-5 6.5-5s5.7 1.8 6.5 5"/><path d="M19 4.5v4M17 6.5h4"/></svg>
          {% endcall %}
        </ul>
      </section>

      <section class="app-prototype-index">
        <h2 class="govuk-heading-m app-prototype-index__heading">Key pages</h2>
        <ul class="app-prototype-list">
          {% call prototypeItem("/jobs" + schoolUser, "Manage jobs", "Active job listings for a school, including copy, close early and extend.") %}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#1d70b8" stroke-width="1.5" aria-hidden="true"><rect x="3.5" y="7.5" width="17" height="13" rx="1"/><path d="M8.5 7.5V6a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v1.5"/></svg>
          {% endcall %}
          {% call prototypeItem("/jobs/draft" + schoolUser, "Draft jobs", "Unpublished listings.") %}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#1d70b8" stroke-width="1.5" aria-hidden="true"><rect x="3.5" y="7.5" width="17" height="13" rx="1"/><path d="M8.5 7.5V6a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v1.5"/></svg>
          {% endcall %}
          {% call prototypeItem("/jobs/scheduled" + schoolUser, "Scheduled jobs", "Listings waiting to go live.") %}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#1d70b8" stroke-width="1.5" aria-hidden="true"><rect x="3.5" y="7.5" width="17" height="13" rx="1"/><path d="M8.5 7.5V6a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v1.5"/></svg>
          {% endcall %}
          {% call prototypeItem("/jobs/closed" + schoolUser, "Closed jobs", "Expired and closed listings.") %}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#1d70b8" stroke-width="1.5" aria-hidden="true"><rect x="3.5" y="7.5" width="17" height="13" rx="1"/><path d="M8.5 7.5V6a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v1.5"/></svg>
          {% endcall %}
          {% call prototypeItem("/jobs/awaiting-feedback" + schoolUser, "Jobs awaiting feedback", "Ask whether a job was filled through Teaching Vacancies.") %}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#1d70b8" stroke-width="1.5" aria-hidden="true"><rect x="3.5" y="7.5" width="17" height="13" rx="1"/><path d="M8.5 7.5V6a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v1.5"/></svg>
          {% endcall %}
          {% call prototypeItem("/jobs/templates" + schoolUser, "Job templates", "Reusable listing templates.") %}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#1d70b8" stroke-width="1.5" aria-hidden="true"><path d="M5.5 19.5h13v-13l-4-4h-9z"/><path d="M14.5 2.5v4h4"/><path d="M8.5 12.5h7M8.5 15.5h5"/></svg>
          {% endcall %}
          {% call prototypeItem("/jobs/new" + schoolUser, "Create a job listing", "Start the create listing journey.") %}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#1d70b8" stroke-width="1.5" aria-hidden="true"><path d="M5.5 19.5h13v-13l-4-4h-9z"/><path d="M14.5 2.5v4h4"/><path d="M8.5 12.5h7M8.5 15.5h5"/></svg>
          {% endcall %}
          {% call prototypeItem("/messages" + schoolUser, "Messages", "Organisation inbox and archive.") %}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#1d70b8" stroke-width="1.5" aria-hidden="true"><path d="M4.5 6.5h15v11h-9l-4 3v-3h-2z"/></svg>
          {% endcall %}
          {% call prototypeItem("/jobseekers" + schoolUser, "Candidate profiles", "Search and invite candidates.") %}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#1d70b8" stroke-width="1.5" aria-hidden="true"><circle cx="9" cy="8" r="2.75"/><circle cx="16" cy="9" r="2.25"/><path d="M4.5 19c.7-2.8 2.6-4.3 5.5-4.3 1.2 0 2.2.3 3.1.8"/><path d="M13.5 19c.5-2.2 1.9-3.4 4-3.4 1.6 0 2.8.7 3.5 1.9"/></svg>
          {% endcall %}
          {% call prototypeItem("/statistics" + schoolUser, "Statistics", "Overview and equal opportunities across all jobs.") %}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#1d70b8" stroke-width="1.5" aria-hidden="true"><path d="M4.5 19.5h15"/><path d="M7 16.5v-5"/><path d="M12 16.5V7.5"/><path d="M17 16.5v-8"/></svg>
          {% endcall %}
          {% call prototypeItem("/notifications" + schoolUser, "Notifications", "Hiring staff notifications.") %}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#1d70b8" stroke-width="1.5" aria-hidden="true"><path d="M6 16.5h12l-1.2-2.2V10a4.8 4.8 0 0 0-9.6 0v4.3z"/><path d="M10 16.5a2 2 0 0 0 4 0"/></svg>
          {% endcall %}
          {% call prototypeItem("/organisation" + schoolUser, "Organisation profile", "School profile used on listings.") %}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#1d70b8" stroke-width="1.5" aria-hidden="true"><path d="M4.5 19.5h15"/><path d="M6.5 19.5V6.5h7v13"/><path d="M13.5 10.5h4v9"/><path d="M8.5 9.5h3M8.5 12.5h3M8.5 15.5h3"/></svg>
          {% endcall %}
          {% call prototypeItem("/organisation" + collegeUser, "Incomplete college profile", "Hope college profile with missing information.") %}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#1d70b8" stroke-width="1.5" aria-hidden="true"><path d="M4.5 19.5h15"/><path d="M6.5 19.5V6.5h7v13"/><path d="M13.5 10.5h4v9"/><path d="M8.5 9.5h3M8.5 12.5h3M8.5 15.5h3"/></svg>
          {% endcall %}
          {% call prototypeItem("/account/sign-in-as-profile", "Sign in as a specific user", "Switch between hiring staff test accounts.") %}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#1d70b8" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="8" r="3.25"/><path d="M5.5 19.25c.8-3.2 3-5 6.5-5s5.7 1.8 6.5 5"/><path d="M19 4.5v4M17 6.5h4"/></svg>
          {% endcall %}
        </ul>
      </section>

      <section class="app-prototype-index">
        <h2 class="govuk-heading-m app-prototype-index__heading">References</h2>
        <ul class="app-prototype-list">
          {% call prototypeItem("https://tv-design-history.herokuapp.com/", "Teaching Vacancies design history", "Analysis, design and research from the Teaching Vacancies service.") %}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#1d70b8" stroke-width="1.5" aria-hidden="true"><path d="M7.5 3.5h6l4 4v13h-10z"/><path d="M13.5 3.5v4h4"/><path d="M9.5 12.5h6M9.5 15.5h6"/></svg>
          {% endcall %}
          {% call prototypeItem("https://design-system.service.gov.uk/components/", "GOV.UK Design System", "Reusable components for building consistent government services.") %}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#1d70b8" stroke-width="1.5" aria-hidden="true"><path d="M12 3.5 4.5 7v4.5c0 5 3.2 7.7 7.5 9 4.3-1.3 7.5-4 7.5-9V7z"/></svg>
          {% endcall %}
          {% call prototypeItem("https://design.education.gov.uk/standards", "DfE design standards", "Principles and guidelines for accessible DfE digital services.") %}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="#1d70b8" stroke-width="1.5" aria-hidden="true"><path d="M12 3.5 4.5 7v4.5c0 5 3.2 7.7 7.5 9 4.3-1.3 7.5-4 7.5-9V7z"/></svg>
          {% endcall %}
        </ul>
      </section>
    </div>
  </div>
{% endblock %}
