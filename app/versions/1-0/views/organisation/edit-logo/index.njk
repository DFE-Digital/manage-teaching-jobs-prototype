{% extends "layout.njk" %}

{% if user.organisation.schools %}
  {% set caption = 'Organisation profile' %}
{% else %}
  {% set caption = 'School profile' %}
{% endif %}
{% set heading = 'Organisation logo' %}
{% set title = heading + ' - ' + caption %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: "/organisation"
  }) }}
{% endblock %}

{% block content %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <span class="govuk-caption-l">{{ caption }}</span>
      <h1 class="govuk-heading-l">{{ heading }}</h1>

      <p class="govuk-body">The logo must be:</p>

      <ul class="govuk-list govuk-list--bullet">
        <li>a PNG, JPG or JPEG</li>
        <li>smaller than 5MB</li>
      </ul>

      <p class="govuk-body">The logo will display the best if it is a square.</p>

      <p class="govuk-body">
        <a class="govuk-link" href="#">Contact support</a> if you need help adding your organisation logo.
      </p>

      <form method="post" enctype="multipart/form-data" class="govuk-!-margin-top-6">

        {{ govukFileUpload({
          id: "organisation-logo",
          name: "organisation-logo",
          label: {
            text: "Upload a file",
            classes: "govuk-label--m"
          },
          javascript: true,
          chooseFilesButtonText: "Choose file",
          dropInstructionText: "or drop file",
          attributes: {
            accept: ".png,.jpg,.jpeg,image/png,image/jpeg"
          }
        }) }}

        {{ govukButton({
          text: "Update organisation logo",
          classes: "govuk-!-margin-top-6"
        }) }}
      </form>

      <p class="govuk-body govuk-!-margin-top-3">
        <a class="govuk-link" href="/organisation">Cancel</a>
      </p>

    </div>
  </div>

{% endblock %}
