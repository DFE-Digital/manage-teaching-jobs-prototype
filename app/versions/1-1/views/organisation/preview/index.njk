{% extends "layout.njk" %}
{% set title = organisation.name %}
{% set primaryNavId = 'organisation' %}

{% set address %}
  {% for part, value in organisation.address %}
    {{ value }}{% if not loop.last %}, {% endif %}
  {% endfor %}
{% endset %}

{% set schoolType %}
  {{ organisation.type }}{% if organisation.religion and organisation.religion != 'Not entered' %}, {{ organisation.religion }}{% endif %}{% if organisation.ageGroup %}, ages {{ organisation.ageGroup }}{% endif %}
{% endset %}

{% if organisation.website != 'Not entered' %}
  {% set website %}
    <a class="govuk-link" href="{{ organisation.website }}" rel="noopener noreferrer">{{ organisation.website }} (opens in new tab)</a>
  {% endset %}
{% endif %}

{% set logoPlaceholder = "/public/images/placeholders/school-logo.svg" %}
{% set photoPlaceholder = "/public/images/placeholders/school-photo.svg" %}
{% set previewLogo = logoPlaceholder if organisation.logo == 'Not entered' or organisation.logo == logoPlaceholder else organisation.logo %}
{% set mapPlaceholder = "/public/images/placeholders/map.svg" %}

{% block beforeContent %}
  {% if organisation.id == user.organisation.id %}
    {{ govukBackLink({
      text: "Edit preview",
      href: "/organisation"
    }) }}
  {% else %}
    {{ govukBackLink({
      text: "Edit preview",
      href: "/organisation/schools/" + organisation.id
    }) }}
  {% endif %}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <div class="app-school-title app-school-title--preview">
        <img class="app-school-title__logo" src="{{ previewLogo }}" alt="" width="100" height="100">
        <h1 class="govuk-heading-l govuk-!-margin-bottom-1">{{ title }}</h1>
        <p class="govuk-body govuk-!-margin-bottom-0">{{ address }}</p>
      </div>

    </div>
  </div>

  {% if organisation.schools %}
    {{ appSubNavigation({
      items: [{
        href: '/organisation/' + organisation.id + '/preview',
        text: 'Organisation',
        active: true
      }, {
        href: '/organisation/' + organisation.id + '/preview/schools',
        text: 'Schools'
      }]
    }) }}
  {% endif %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <h2 class="govuk-heading-m">Summary</h2>

      {% if organisation.parentOrganisation %}
        <p class="govuk-body">Part of <a class="govuk-link" href="/organisation/{{ organisation.parentOrganisation.id }}/preview">{{ organisation.parentOrganisation.name }}</a>.</p>
      {% endif %}

      {{ govukSummaryList({
        rows: [
          {
            key: { text: "School name" },
            value: { text: organisation.name }
          },
          {
            key: { text: "Address" },
            value: { text: address }
          },
          {
            key: { text: "School type" },
            value: { text: schoolType }
          } if organisation.type,
          {
            key: { text: "Education phase" },
            value: { text: organisation.phase }
          } if organisation.phase and organisation.phase != 'Not entered',
          {
            key: { text: "Age range" },
            value: { text: organisation.ageGroup }
          } if organisation.ageGroup,
          {
            key: { text: "Size" },
            value: { text: organisation.size + " pupils enrolled" }
          } if organisation.size,
          {
            key: { text: "Website address" },
            value: { html: website }
          } if organisation.website != 'Not entered',
          {
            key: { text: "Ofsted report" },
            value: { html: '<a class="govuk-link" href="#">View Ofsted report (opens in new tab)</a>' }
          } if not organisation.schools
        ]
      }) }}

      {% if organisation.safeguardingCommitment != 'Not entered' %}
        <h2 class="govuk-heading-m govuk-!-margin-top-8">Commitment to safeguarding</h2>
        <div class="govuk-body">{{ organisation.safeguardingCommitment | escape | nl2br }}</div>
      {% endif %}

      <h2 class="govuk-heading-m govuk-!-margin-top-8">Location and map</h2>
      <p class="govuk-body">{{ address }}</p>
      <div class="app-map app-map--placeholder govuk-!-margin-bottom-8">
        <img src="{{ mapPlaceholder }}" alt="Map showing the location of {{ organisation.name }}" width="630" height="400">
      </div>

      <h2 class="govuk-heading-m">Current jobs</h2>
      {% if jobs.length %}
        {{ appJobList({
          jobs: jobs,
          heading: {
            level: 3,
            classes: 'govuk-heading-m app-job-list__title'
          }
        }) }}
      {% else %}
        <p class="govuk-body">There are no current jobs at this school.</p>
      {% endif %}

      <h2 class="govuk-heading-m govuk-!-margin-top-8">Set up a job alert</h2>
      <p class="govuk-body">Get a job alert whenever a role is listed at {{ organisation.name }}.</p>
      {{ govukButton({
        text: "Set up job alert"
      }) }}

    </div>
  </div>
{% endblock %}
