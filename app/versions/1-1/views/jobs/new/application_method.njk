{% extends "layout.njk" %}

{% from "includes/create-job-save-later-button.njk" import saveAndFinishLater %}

{% set heading = 'Choose your application form' %}
{% set caption = createJobCaption.applicationsAndPublish %}
{% set title = heading + ' - ' + caption %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: "/jobs/new/listing-dates"
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">
        {{caption}}
      </span>
      <h1 class="govuk-heading-l">
        {{heading}}
      </h1>

      <p class="govuk-body">How do you want to receive applications for this job?</p>

      {{ govukDetails({
        summaryText: "About KCSIE compliant application forms",
        html: '
          <p class="govuk-body">Teaching Vacancies forms comply with <a class="govuk-link" href="https://www.gov.uk/government/publications/keeping-children-safe-in-education--2" target="_blank" rel="noopener noreferrer">Keeping children safe in education (KCSIE) guidance (opens in new tab)</a>. Online forms make it quicker for jobseekers to apply.</p>
          <p class="govuk-body">Use the KCSIE option unless applicants must provide religious information — then choose another method.</p>
        '
      }) }}

      <form action="/jobs/new/application_method" method="post" class="govuk-!-margin-top-6">

        <div class="govuk-form-group">
          <fieldset class="govuk-fieldset" aria-describedby="signIn-hint">
            <div class="govuk-radios" data-module="govuk-radios">
              <div class="govuk-radios__item">
                <input class="govuk-radios__input" id="signIn" name="signIn" type="radio" value="online">
                <label class="govuk-label govuk-radios__label" for="signIn">
                  KCSIE compliant online application form
                </label>
              </div>
              
              <div class="govuk-radios__divider">or</div>
              <div class="govuk-radios__item">
                <input class="govuk-radios__input" id="signIn-2" name="signIn" type="radio" value="other" aria-describedby="signIn-2-item-hint">
                <label class="govuk-label govuk-radios__label" for="signIn-2">
                  Use other application form method
                </label>
                <div id="signIn-2-item-hint" class="govuk-hint govuk-radios__hint">
                 You'll need to provide additional details about how to apply.
                </div>
              </div>
            </div>
          </fieldset>
        </div>

        {{ govukButton({
          text: "Save and continue"
        }) }}

        {{ saveAndFinishLater(path) }}
      </form>
      <p><a href="#">Cancel</a></p>



    </div>
  </div>

{% endblock %}
