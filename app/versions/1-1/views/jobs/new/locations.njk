{% extends "layout.njk" %}

{% from "includes/create-job-save-later-button.njk" import saveAndFinishLater %}

{% set heading = 'Locations where the job is based' %}
{% set caption = createJobCaption.jobDetails %}
{% set title = heading + ' - ' + caption %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: "/jobs/new/start"
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% set h1 %}
        <span class="govuk-caption-l">
          {{caption}}
        </span>
        {{heading}}
      {% endset %}

      <form action="/jobs/new/locations" method="post" novalidate>
        {{ govukCheckboxes({
          idPrefix: "createJob[locations]",
          name: "createJob[locations]",
          fieldset: {
            legend: {
              html: h1,
              isPageHeading: true,
              classes: "govuk-fieldset__legend--l"
            }
          },
          items: locationOptions
        }) }}

        {{ govukButton({
          text: "Save and continue"
        }) }}

        {{ saveAndFinishLater(path) }}

      </form>

      <p><a href="#">Cancel</a></p>



    </div>
  </div>

{% endblock %}
