{% extends "layout.njk" %}

{% from "includes/create-job-save-later-button.njk" import saveAndFinishLater %}

{% set heading = 'Education phase' %}
{% set caption = createJobCaption.jobDetails %}
{% set title = heading + ' - ' + caption %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: "javascript:history.back();"
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% if query.multipleLocationsMissing %}
        <span class="govuk-caption-l">
          {{caption}}
        </span>
        <h1 class="govuk-heading-l">
          {{heading}}
        </h1>
      {% else %}
        {% set h1 %}
          <span class="govuk-caption-l">
            {{caption}}
          </span>
          {{heading}}
        {% endset %}
      {% endif %}

      <form action="/jobs/new/phase" method="post">

        {% if query.multipleLocationsMissing %}
          {{ govukRadios({
            idPrefix: "createJob[phase]",
            name: "createJob[phase]",
            fieldset: {
              legend: {
                html: 'Education phase for [location 1]',
                classes: "govuk-fieldset__legend--m"
              }
            },
            items: options
          }) }}

          {{ govukRadios({
            idPrefix: "createJob[phase]",
            name: "createJob[phase]",
            fieldset: {
              legend: {
                html: 'Education phase for [location 2]',
                classes: "govuk-fieldset__legend--m"
              }
            },
            items: options
          }) }}
        {% else %}

            {% set savedPhase = data.createJob.phase if data.createJob else none %}
            {% if savedPhase is string %}
              {% set savedPhases = [savedPhase] %}
            {% elif savedPhase %}
              {% set savedPhases = savedPhase %}
            {% else %}
              {% set savedPhases = [] %}
            {% endif %}

            {% if user.organisation.name == 'LS Secondary School and College' %}
             
              {% set options = [
               { value: 'Secondary school', text: 'Secondary school', checked: 'Secondary school' in savedPhases },
               { value: 'Sixth form or college', text: 'Sixth form or college', checked: 'Sixth form or college' in savedPhases },
               { value: 'Through school', text: 'All through school', checked: 'Through school' in savedPhases }
              ] %}

            {% elif user.organisation.name == 'ML Secondary School' %}

              {% set options = [
               { value: 'Secondary school', text: 'Secondary school', checked: 'Secondary school' in savedPhases },
               { value: 'Sixth form or college', text: 'Sixth form or college', checked: 'Sixth form or college' in savedPhases },
               { value: 'Through school', text: 'All through school', checked: 'Through school' in savedPhases }
               ] %}

            {% else %}
           
             {% set options = [
               { value: 'Nursery', text: 'Nursery', checked: 'Nursery' in savedPhases },
               { value: 'Primary school', text: 'Primary school', checked: 'Primary school' in savedPhases },
               { value: 'Secondary school', text: 'Secondary school', checked: 'Secondary school' in savedPhases },
               { value: 'Sixth form or college', text: 'Sixth form or college', checked: 'Sixth form or college' in savedPhases },
               { value: 'Through school', text: 'All through school', checked: 'Through school' in savedPhases }
             ] %}
           {% endif %}

          {{ govukCheckboxes({
            idPrefix: "createJob[phase]",
            name: "createJob[phase]",
            fieldset: {
              legend: {
                html: h1,
                isPageHeading: true,
                classes: "govuk-fieldset__legend--l"
              }
            },
            items: options
          }) }}


        {% endif %}




        {{ govukButton({
          text: "Save and continue"
        }) }}

        {{ saveAndFinishLater(path) }}

      </form>

      <p><a href="#">Cancel</a></p>

    </div>
  </div>

{% endblock %}
