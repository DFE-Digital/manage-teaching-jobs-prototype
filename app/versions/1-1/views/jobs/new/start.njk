{% extends "layout.njk" %}

{% set heading = 'Create a job listing' %}
{% set title = heading %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back to manage jobs",
    href: "/jobs"
  }) }}
{% endblock %}

{% block content %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

      {{ govukNotificationBanner({
        html: '<h2 class="govuk-heading-m govuk-!-margin-bottom-0">' + flash + '</h2>',
        type: 'success',
        icon: false
      }) if flash and flash.length }}

      <h1 class="govuk-heading-l">{{ heading }}</h1>

      <p class="govuk-body">
        You can save a draft at any step and finish later. To continue a saved listing, go to manage jobs and select draft jobs.
      </p>

      {{ govukDetails({
        summaryText: "What you will need",
        html: '
          <p class="govuk-body">Before you publish, you will need:</p>
          <ul class="govuk-list govuk-list--bullet">
            <li>contract type, salary and working pattern</li>
            <li>a job description or person specification (optional file)</li>
            <li>publish and closing dates</li>
            <li>how you want to receive applications</li>
          </ul>
        '
      }) }}

      {% include "includes/create-job-task-list.njk" %}

      <div class="govuk-button-group govuk-!-margin-top-6">
        {{ govukButton({
          text: "Save and finish later",
          href: "/jobs/new/start",
          classes: "govuk-button--secondary"
        }) }}

        {{ govukButton({
          text: "Abandon job listing",
          href: "/jobs/new/abandon",
          classes: "govuk-button--warning"
        }) }}
      </div>

    </div>
  </div>

{% endblock %}