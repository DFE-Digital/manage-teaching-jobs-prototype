{% extends "layout.njk" %}

{% from "includes/create-job-save-later-button.njk" import saveAndFinishLater %}

{% set heading = 'Working patterns' %}
{% set caption = createJobCaption.payAndContract %}
{% set title = heading + ' - ' + caption %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: "javascript:history.back();"
  }) }}
{% endblock %}

{% block content %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% if errorSummary.items.length %}
        {{ govukErrorSummary({
          titleText: 'There’s a problem',
          errorList: errorSummary.items
        }) }}
      {% endif %}

      {% set h1 %}
        <span class="govuk-caption-l">
          {{caption}}
        </span>
        {{heading}}
      {% endset %}

      {% set fullTimeDetails %}
        {{ govukCharacterCount({
          name: "createJob[fullTimeDetails]",
          id: "createJob[fullTimeDetails]",
          maxwords: 50,
          label: {
            text: "How many hours per week is required from this role and what are the working hours?",
            classes: 'govuk-label--s'
          },
          hint: {
              text: 'For example, usually at least 36.5 hours a week',
              text: 'For example, usually at least 27.5 hours a week'
            },
          value: data['createJob']['fullTimeDetails'],
          errorMessage: inlineErrors['createJob'].partTimeDetails
        }) }}
      {% endset %}

      {% set partTimeDetails %}
        {{ govukCharacterCount({
          name: "createJob[partTimeDetails]",
          id: "createJob[partTimeDetails]",
          maxwords: 50,
          label: {
            text: "How many hours per week is required from this role and what are the working hours?",
            classes: 'govuk-label--s'
          },
          value: data['createJob']['partTimeDetails'],
          errorMessage: inlineErrors['createJob'].partTimeDetails
        }) }}
      {% endset %}

      <form action="/jobs/new/working-patterns" method="post">

        {{ govukCheckboxes({
          idPrefix: "createJob[workingPatterns]",
          name: "createJob[workingPatterns]",
          fieldset: {
            legend: {
              html: h1,
              isPageHeading: true,
              classes: "govuk-fieldset__legend--l"
            }
          },
          hint: {
            text: "Select all that apply."
          },
          errorMessage: inlineErrors['createJob'].workingPatterns,
          items: [
            {
              value: "Full time",
              text: "Full time",
              checked: checked("['createJob']['workingPatterns']", "Full time") or checked("['createJob']['workingPatterns']", "full time") or checked("working-patterns", "Full time") or checked("working-patterns", "full time")
            },
            {
              value: "Part time",
              text: "Part time",
              checked: checked("['createJob']['workingPatterns']", "Part time") or checked("['createJob']['workingPatterns']", "part time") or checked("working-patterns", "Part time") or checked("working-patterns", "part time")
            },
            {
              value: "Flexible",
              text: "Flexible",
              checked: checked("['createJob']['workingPatterns']", "Flexible") or checked("working-patterns", "Flexible") or checked("working-patterns", "flexible")
            },
            {
              value: "Job share",
              text: "Job share",
              checked: checked("['createJob']['workingPatterns']", "Job share") or checked("working-patterns", "Job share") or checked("working-patterns", "job share")
            },
            {
              value: "Term time",
              text: "Term time",
              checked: checked("['createJob']['workingPatterns']", "Term time") or checked("working-patterns", "Term time") or checked("working-patterns", "term time")
            }
          ]
        }) }}

        {{ govukCharacterCount({
          name: "createJob[partTimeDetails]",
          id: "createJob[partTimeDetails]",
          maxwords: 50,
          label: {
            text: "Details of working hours (optional)",
            classes: 'govuk-label--s'
          },
          hint: {
            text: "For example, 32.5 hours a week."
          },
          value: data['createJob']['partTimeDetails'],
          errorMessage: inlineErrors['createJob'].partTimeDetails
        }) }}

        {{ govukButton({
          text: "Save and continue"
        }) }}

        {{ saveAndFinishLater(path) }}
      </form>
      <p><a href="#">Cancel</a></p>



    </div>
  </div>

{% endblock %}
