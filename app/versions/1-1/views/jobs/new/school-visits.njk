{% extends "layout.njk" %}

{% from "includes/create-job-save-later-button.njk" import saveAndFinishLater %}


{% if user.organisation.name == 'Hope college' %}

{% set heading = 'Do you want to offer college visits?' %}

{% else %}

{% set heading = 'Do you want to offer school visits?' %}

{% endif %}
{% set caption = createJobCaption.aboutTheRole %}
{% set title = heading + ' - ' + caption %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: "javascript:history.back();"
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% set h1 %}
        <span class="govuk-caption-l">
          {{caption}}
        </span>
        {{heading}}
      {% endset %}

      <form action="/jobs/new/school-visits" method="post">

        {{ govukRadios({
          idPrefix: "createJob[school-visits]",
          name: "createJob[school-visits]",
          fieldset: {
            legend: {
              html: h1,
              isPageHeading: true,
              classes: "govuk-fieldset__legend--l"
            }
          },
          items: [
            {
              value: "Yes",
              text: "Yes",
              checked: checked("['createJob']['school-visits']", "Yes")
            },
            {
              value: "No",
              text: "No",
              checked: checked("['createJob']['school-visits']", "No")
            }
          ]
        }) }}

        {{ govukButton({
          text: "Save and continue"
        }) }}

        {{ saveAndFinishLater(path) }}
      </form>
      <p><a href="#">Cancel</a></p>



    </div>
  </div>

{% endblock %}
