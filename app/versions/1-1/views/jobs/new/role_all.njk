{% extends "layout.njk" %}

{% from "includes/create-job-save-later-button.njk" import saveAndFinishLater %}

{% set heading = 'Job role' %}
{% set caption = createJobCaption.jobDetails %}
{% set title = heading + ' - ' + caption %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: "/jobs/new/title"
  }) }}
{% endblock %}

{% block content %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <form action="/jobs/new/role_all" method="post" novalidate>

        <fieldset class="govuk-fieldset">
          <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
            <span class="govuk-caption-l">{{ caption }}</span>
            <span class="govuk-fieldset__heading">What type of job is this?</span>
          </legend>

          <div class="govuk-hint">Select all that apply.</div>

          {% include "includes/create-job-role-checkboxes.njk" %}
        </fieldset>

        {{ govukButton({
          text: "Save and continue"
        }) }}

        {{ saveAndFinishLater(path) }}
      </form>

      <p><a href="#">Cancel</a></p>

    </div>
  </div>

{% endblock %}