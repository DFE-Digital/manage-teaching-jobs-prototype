{% extends "layout.njk" %}

{% from "includes/create-job-save-later-button.njk" import saveAndFinishLater %}

{% set version = 2 %}

{% set heading = 'Salary' %}
{% set caption = createJobCaption.payAndContract %}
{% set title = heading + ' - ' + caption %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: "javascript:history.back();"
  }) }}
{% endblock %}

{% block content %}

  {% set salary %}
    {{ govukInput({
      id: "createJob[full-time-salary]",
      name: "createJob[full-time-salary]",
      label: {
        text: "Full-time equivalent salary",
        classes: 'govuk-label--s'
      },
      hint: {
        text: 'For example, ‘Between £20,000 and £40,000’.'
      },
      classes: "govuk-input--width-20",
      value: data['createJob']['full-time-salary']
    }) }}
  {% endset %}

  {% set actualSalary %}
    {{ govukInput({
      id: "createJob[actual-salary]",
      name: "createJob[actual-salary]",
      label: {
        text: "Actual salary",
        classes: 'govuk-label--s'
      },
      classes: "govuk-input--width-20",
      value: data['createJob']['actual-salary']
    }) }}
  {% endset %}

  {% set payscale %}
    {{ govukInput({
      id: "createJob[pay-scale]",
      name: "createJob[pay-scale]",
      label: {
        text: "Pay scale",
        classes: 'govuk-label--s'
      },
      hint: {
        text: 'For example, ‘M1 to M2.’'
      },
      classes: "govuk-input--width-20",
      value: data['createJob']['pay-scale']
    }) }}
  {% endset %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <h1 class="govuk-heading-l">
        <span class="govuk-caption-l">
          {{caption}}
        </span>
        {{heading}}
      </h1>

      <form action="/jobs/new/salary" method="post" novalidate>
        {{ govukCheckboxes({
          idPrefix: "createJob[salary-details]",
          name: "createJob[salary-details]",
          fieldset: {
            legend: {
              html: 'Salary details',
              isPageHeading: false,
              classes: "govuk-fieldset__legend--m"
            }
          },
          hint: {
            text: 'Select all that apply.'
          },
          items: [
            {
              value: "Full-time equivalent salary",
              text: "Full-time equivalent salary",
              checked: checked("['createJob']['salary-details']", "Full-time equivalent salary") or (data.createJob and data.createJob['full-time-salary']),
              hint: {
                text: 'This is what the annual salary would be for someone working full time.'
              },
              conditional: {
                html: salary
              }
            },
            {
              value: "Actual salary",
              text: "Actual salary",
              checked: checked("['createJob']['salary-details']", "Actual salary") or (data.createJob and data.createJob['actual-salary']),
              hint: {
                text: 'This is the annual amount someone will take home.'
              },
              conditional: {
                html: actualSalary
              }
            },
            {
              value: "Pay scale",
              text: "Pay scale",
              checked: checked("['createJob']['salary-details']", "Pay scale") or (data.createJob and data.createJob['pay-scale']),
              conditional: {
                html: payscale
              }
            }
          ]
        }) }}

        {{ govukButton({
          text: "Save and continue"
        }) }}

        {{ saveAndFinishLater(path) }}
      </form>
      <p><a href="#">Cancel</a></p>



    </div>
  </div>

{% endblock %}
