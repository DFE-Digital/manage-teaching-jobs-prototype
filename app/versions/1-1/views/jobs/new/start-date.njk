{% extends "layout.njk" %}

{% from "includes/create-job-save-later-button.njk" import saveAndFinishLater %}

{% set heading = 'Job start date' %}
{% set caption = createJobCaption.payAndContract %}
{% set title = heading + ' - ' + caption %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: "javascript:history.back();"
  }) }}
{% endblock %}

{% block content %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% set h1 %}
        <span class="govuk-caption-l">
          {{caption}}
        </span>
        {{heading}}
      {% endset %}

        {% set specificDate = data.createJob['start-date--specific'] if data.createJob and data.createJob['start-date--specific'] else {} %}
        {% set dateHtml %}
          {{ govukDateInput({
            id: "createJob[start-date--specific]",
            name: "createJob[start-date--specific]",
            fieldset: {
              legend: {
                text: "Date",
                classes: "govuk-fieldset__legend--s"
              }
            },
            hint: {
              text: "For example, 31 3 2023"
            },
            items: [{
              name: "createJob[start-date--specific][day]",
              label: "Day",
              classes: "govuk-input--width-2",
              value: specificDate.day
            }, {
              name: "createJob[start-date--specific][month]",
              label: "Month",
              classes: "govuk-input--width-2",
              value: specificDate.month
            }, {
              name: "createJob[start-date--specific][year]",
              label: "Year",
              classes: "govuk-input--width-4",
              value: specificDate.year
            }]
          }) }}
        {% endset %}

        {% set fromDate = data.createJob['start-date--from'] if data.createJob and data.createJob['start-date--from'] else {} %}
        {% set toDate = data.createJob['start-date--to'] if data.createJob and data.createJob['start-date--to'] else {} %}
        {% set rangeHtml %}
          {{ govukDateInput({
            id: "createJob[start-date--from]",
            name: "createJob[start-date--from]",
            fieldset: {
              legend: {
                text: "Earliest start date",
                classes: "govuk-fieldset__legend--s"
              }
            },
            hint: {
              text: "For example, 31 3 2023"
            },
            items: [{
              name: "createJob[start-date--from][day]",
              label: "Day",
              classes: "govuk-input--width-2",
              value: fromDate.day
            }, {
              name: "createJob[start-date--from][month]",
              label: "Month",
              classes: "govuk-input--width-2",
              value: fromDate.month
            }, {
              name: "createJob[start-date--from][year]",
              label: "Year",
              classes: "govuk-input--width-4",
              value: fromDate.year
            }]
          }) }}

          {{ govukDateInput({
            id: "createJob[start-date--to]",
            name: "createJob[start-date--to]",
            fieldset: {
              legend: {
                text: "Latest start date",
                classes: "govuk-fieldset__legend--s"
              }
            },
            hint: {
              text: "For example, 31 4 2023"
            },
            items: [{
              name: "createJob[start-date--to][day]",
              label: "Day",
              classes: "govuk-input--width-2",
              value: toDate.day
            }, {
              name: "createJob[start-date--to][month]",
              label: "Month",
              classes: "govuk-input--width-2",
              value: toDate.month
            }, {
              name: "createJob[start-date--to][year]",
              label: "Year",
              classes: "govuk-input--width-4",
              value: toDate.year
            }]
          }) }}
        {% endset %}

        {% set otherHtml %}
          {{ govukInput({
            id: "createJob[start-date--other]",
            name: "createJob[start-date--other]",
            label: {
              text: "Details",
              classes: "govuk-label--s"
            },
            hint: {
              text: "For example ‘Easter term’"
            },
            value: data['createJob']['start-date--other']
          }) }}
        {% endset %}

      
        <form action="/jobs/new/start-date" method="post">

        {{ govukRadios({
          idPrefix: "createJob[start-date]",
          name: "createJob[start-date]",
          fieldset: {
            legend: {
              html: h1,
              isPageHeading: true,
              classes: "govuk-fieldset__legend--l"
            }
          },
          items: [
            {
              value: "As soon as possible",
              text: "As soon as possible",
              checked: checked("['createJob']['start-date']", "As soon as possible")
            },
            {
              value: "Specific date",
              text: "Specific date",
              checked: checked("['createJob']['start-date']", "Specific date"),
              conditional: {
                html: dateHtml
              }
            },
            {
              value: "Date range",
              text: "Date range",
              checked: checked("['createJob']['start-date']", "Date range"),
              conditional: {
                html: rangeHtml
              }
            },
            {
              value: "Other",
              text: "Other",
              checked: checked("['createJob']['start-date']", "Other"),
              conditional: {
                html: otherHtml
              }
            }
          ]
        }) }}

        {{ govukButton({
          text: "Save and continue"
        }) }}

        {{ saveAndFinishLater(path) }}

      </form>

      <p><a href="#">Cancel</a></p>



    </div>
  </div>

{% endblock %}
