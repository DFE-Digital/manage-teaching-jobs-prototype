{% extends "layout.njk" %}

{% from "includes/create-job-save-later-button.njk" import saveAndFinishLater %}

{% set heading = 'Job listing copied' %}
{% set caption = createJobCaption.createListing %}
{% set title = heading + ' - ' + caption %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: "javascript:history.back();"
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <span class="govuk-caption-l">
        {{caption}}
      </span>
      <h1 class="govuk-heading-l">
        {{heading}}
      </h1>

      <p>You’ve copied the ‘Maths teacher’ job listing.</p>

      <p>Next, you’ll be asked to update the:</p>

      <ul class="govuk-list govuk-list--bullet">
        <li>
          job title
        </li>
        <li>
          publish and closing dates
        </li>
        <li>
          start date of job
        </li>
      </ul>
      <form action="/jobs/new/title">

        {{ govukButton({
          text: "Save and continue"
        }) }}

        {{ saveAndFinishLater(path) }}

      </form>

      <p><a href="#">Cancel</a></p>



    </div>
  </div>

{% endblock %}
