{% extends "layout.njk" %}

{% from "includes/create-job-save-later-button.njk" import saveAndFinishLater %}
{% from "includes/job-start-date-display.njk" import jobStartDateDisplay %}

{% set scheduling = data.createJob and data.createJob.publishDate != 'Today (6 June 2022)' %}
{% if scheduling %}
  {% set buttonText = 'Schedule job listing' %}
  {% set heading = 'Check details and schedule job listing' %}
{% else %}
  {% set buttonText = 'Publish job listing' %}
  {% set heading = 'Check details and publish job listing' %}
{% endif %}

{% set hideAdditionalAllowances = isCollegeFeCreateJob(data, user) %}
{% if user.organisation.name == 'Hope college' %}
  {% set schoolVisitsText = 'Do you want to offer college visits?' %}
  {% set schoolOfferText = 'What does your college offer?' %}
{% else %}
  {% set schoolVisitsText = 'Do you want to offer school visits?' %}
  {% set schoolOfferText = 'What does your school offer?' %}
{% endif %}

{% set caption = createJobCaption.checkAndPublish %}
{% set title = heading + ' - ' + caption %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back to task list",
    href: "/jobs/new/start"
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

      <span class="govuk-caption-l">
        {{caption}}
      </span>
      <h1 class="govuk-heading-l">
        {{heading}}
      </h1>

      <h2 class="govuk-heading-m">
        Job details
      </h2>

      {% if data.createJob.locations %}
        {{ govukSummaryList({
          card: {
            title: { text: "Job location", headingLevel: 3 },
            actions: {
              items: [{ href: "/jobs/new/locations", text: "Change", visuallyHiddenText: "job location" }]
            }
          },
          rows: [
            {
              key: { text: "Locations where the job is based" },
              value: { text: "Farnham Heath End, Hale Reeds, Farnham, Surrey, GU9 9BN" }
            }
          ]
        }) }}
      {% endif %}

      {{ govukSummaryList({
        card: {
          title: { text: "Job title", headingLevel: 3 },
          actions: {
            items: [{ href: "/jobs/new/title", text: "Change", visuallyHiddenText: "job title" }]
          }
        },
        rows: [
          {
            key: { text: "Job title" },
            value: { text: data['job-title'] or data.createJob.title }
          }
        ]
      }) }}

      {% if data.createJob['key-stages'] is string %}
        {% set keyStageDisplay = data.createJob['key-stages'] %}
      {% elif data.createJob['key-stages'] %}
        {% set keyStageDisplay = data.createJob['key-stages'] | join(', ') %}
      {% endif %}
      {% if data.subjects is string %}
        {% set subjectsDisplay = data.subjects %}
      {% elif data.subjects %}
        {% set subjectsDisplay = data.subjects | join(', ') %}
      {% endif %}

      {{ govukSummaryList({
        card: {
          title: { text: "Job role, phase and subjects", headingLevel: 3 },
          actions: {
            items: [{ href: "/jobs/new/role_all", text: "Change", visuallyHiddenText: "job role, phase and subjects" }]
          }
        },
        rows: [
          {
            key: { text: "Role" },
            value: { text: data['jobRole'] }
          },
          {
            key: { text: "Education phase" },
            value: { text: data.createJob.phase }
          } if data.createJob.phase,
          {
            key: { text: "Key stage" },
            value: { text: keyStageDisplay }
          } if data['createJob']['key-stages'],
          {
            key: { text: "Subjects" },
            value: { text: subjectsDisplay or 'None' }
          } if data['subjects']
        ]
      }) }}

      {% set workingPatterns %}
        {{data['working-patterns']}}
      {% endset %}

      {% set salaryDetails %}
        <ul class="govuk-list govuk-list--spaced govuk-!-margin-bottom-0">
          {% if data.createJob['full-time-salary'] %}
          <li>
            <p>Full-time equivalent salary:<br>
            {{ data.createJob['full-time-salary'] }}</p>
          </li>
          {% endif %}
          {% if data.createJob['actual-salary'] %}
          <li>
            <p>Actual salary:<br>
            {{ data.createJob['actual-salary'] }}</p>
          </li>
          {% endif %}
          {% if data.createJob['pay-scale'] %}
          <li class="govuk-!-margin-bottom-0">
            <p class="govuk-!-margin-bottom-0">Pay scale:<br>
            {{ data.createJob['pay-scale'] }}</p>
          </li>
          {% endif %}
        </ul>
      {% endset %}

      <h2 class="govuk-heading-m">
        Pay and contract
      </h2>

      {{ govukSummaryList({
        card: {
          title: { text: "Contract and working pattern", headingLevel: 3 },
          actions: {
            items: [{ href: "/jobs/new/contract", text: "Change", visuallyHiddenText: "contract and working pattern" }]
          }
        },
        rows: [
          {
            key: { text: "Contract type" },
            value: { text: data['createJob']['contract'] }
          },
          {
            key: { text: "Working patterns" },
            value: { html: workingPatterns }
          }
        ]
      }) }}

      {{ govukSummaryList({
        card: {
          title: { text: "Salary", headingLevel: 3 },
          actions: {
            items: [{ href: "/jobs/new/salary", text: "Change", visuallyHiddenText: "salary" }]
          }
        },
        rows: [
          {
            key: { text: "Salary details" },
            value: { html: salaryDetails }
          }
        ]
      }) }}

      {{ govukSummaryList({
        card: {
          title: { text: "Job start date", headingLevel: 3 },
          actions: {
            items: [{ href: "/jobs/new/start-date", text: "Change", visuallyHiddenText: "job start date" }]
          }
        },
        rows: [
          {
            key: { text: "Job start date" },
            value: { text: jobStartDateDisplay(data) }
          }
        ]
      }) }}

      <h2 class="govuk-heading-m">
        About the role
      </h2>

      {{ govukSummaryList({
        card: {
          title: { text: "About the role", headingLevel: 3 },
          actions: {
            items: [{ href: "/jobs/new/about", text: "Change", visuallyHiddenText: "about the role" }]
          }
        },
        rows: [
          {
            key: { text: "Is this role suitable for an early career teacher (ECT)?" },
            value: { text: data['createJob']['suitability'] }
          } if data['createJob']['suitability'],
          {
            key: { text: "What skills and experience are you looking for?" },
            value: { text: data['createJob']['skills'] }
          },
          {
            key: { text: schoolOfferText },
            value: { text: data['createJob']['benefits'] }
          },
          {
            key: { text: "Do you want to add further details about the role?" },
            value: { text: data['createJob']['other-information'] }
          },
          {
            key: { text: "Further details about the role" },
            value: { text: "Ut eget dolor at libero commodo tincidunt vel egestas diam. Interdum et malesuada fames ac ante ipsum primis in faucibus. Aliquam aliquet risus eget ante viverra tincidunt. Etiam pulvinar metus dolor, in eleifend massa pharetra eget." }
          } if data['createJob']['other-information'] == 'Yes',
          {
            key: { text: "Do you want to upload any additional documents?" },
            value: { text: data['createJob']['upload'] }
          },
          {
            key: { text: "Additional documents" },
            value: { html: '<a href="#">person-spec.pdf (2MB)</a>' }
          } if data['createJob']['upload'] == 'Yes'
        ]
      }) }}

      {{ govukSummaryList({
        card: {
          title: { text: "School visits" if user.organisation.name != 'Hope college' else "College visits", headingLevel: 3 },
          actions: {
            items: [{ href: "/jobs/new/school-visits", text: "Change", visuallyHiddenText: "school visits" }]
          }
        },
        rows: [
          {
            key: { text: schoolVisitsText },
            value: { text: data['createJob']['school-visits'] }
          }
        ]
      }) }}

      {{ govukSummaryList({
        card: {
          title: { text: "Visa sponsorship", headingLevel: 3 },
          actions: {
            items: [{ href: "/jobs/new/sponsorship2", text: "Change", visuallyHiddenText: "visa sponsorship" }]
          }
        },
        rows: [
          {
            key: { text: "Can you offer skilled worker visa sponsorship to non-UK citizens for this role?" },
            value: { text: data['createJob-sponsorship'] or data.createJob.sponsorship }
          }
        ]
      }) }}

      <h2 class="govuk-heading-m">
        Applications and publish
      </h2>

      {{ govukSummaryList({
        card: {
          title: { text: "Publish and closing dates", headingLevel: 3 },
          actions: {
            items: [{ href: "/jobs/new/listing-dates", text: "Change", visuallyHiddenText: "publish and closing dates" }]
          }
        },
        rows: [
          {
            key: { text: "Publish date" },
            value: { text: data.createJob.publishDate }
          },
          {
            key: { text: "Closing date and time" },
            value: { text: '31 April 2024 at 9am' }
          }
        ]
      }) }}

      {{ govukSummaryList({
        card: {
          title: { text: "How to receive applications", headingLevel: 3 },
          actions: {
            items: [{ href: "/jobs/new/application_method", text: "Change", visuallyHiddenText: "how to receive applications" }]
          }
        },
        rows: [
          {
            key: { text: "Do you want to use the application form?" },
            value: { text: data['signIn'] }
          },
          {
            key: { text: "How do you want to receive applications?" },
            value: { text: data['createJob']['process'] }
          } if data['createJob']['method'] == 'No',
          {
            key: { text: "Application form" },
            value: { html: '<a href="">form.pdf (2MB)</a>' }
          } if data['createJob']['process'] == 'By email',
          {
            key: { text: "Through a website" },
            value: { text: data.website or data.createJob.website or 'https://example.com' }
          } if data.createJob.process == 'Through a website' or data.how == 'Through a website',
          {
            key: { text: "Email address to receive applications" },
            value: { html: 'molly@example.com' }
          },
          {
            key: { text: "How would you like to view your applications?" },
            value: { text: data['createJob']['anonymised'] }
          },
          {
            key: { text: "What religious information do you want to ask applicants for?" },
            value: { text: data['religion-question'] }
          }
        ]
      }) }}

      {{ govukSummaryList({
        card: {
          title: { text: "Contact details", headingLevel: 3 },
          actions: {
            items: [{ href: "/jobs/new/contact-details", text: "Change", visuallyHiddenText: "contact details" }]
          }
        },
        rows: [
          {
            key: { text: "Email address" },
            value: { text: "test@example.com" }
          },
          {
            key: { text: "Do you want to give a contact phone number?" },
            value: { text: data['createJob']['provide-phone-number'] }
          },
          {
            key: { text: "Phone number" },
            value: { text: "0207 3456 3746" }
          } if data['createJob']['phone-number']
        ]
      }) }}

      <p><a target="_blank" href="check_preview">Preview job listing (opens in new tab)</a>.</p>

      <p>By publishing this job listing you agree to the <a href="#">terms and conditions</a>.</p>

      <form action="/jobs/new/check" method="post">

        {{ govukButton({
          text: buttonText
        }) }}

        {{ saveAndFinishLater(path) }}
      </form>


    </div>
  </div>

{% endblock %}
