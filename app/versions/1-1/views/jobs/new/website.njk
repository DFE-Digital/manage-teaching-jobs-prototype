{% extends "layout.njk" %}

{% from "includes/create-job-save-later-button.njk" import saveAndFinishLater %}


{% set heading = 'Link to website' %}

{% set caption = createJobCaption.applicationsAndPublish %}
{% set title = heading + ' - ' + caption %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: "javascript:history.back();"
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% set h1 %}
        <span class="govuk-caption-l">
          {{caption}}
        </span>
        {{heading}}
      {% endset %}

      <form action="/jobs/new/website" method="post">

        {{ govukInput({
        label: {
            text: "Link to website",
            classes: "govuk-label--l",
            isPageHeading: true
        },
        hint: {
            text: "For example, https://example.com"
        },
        id: "website",
        name: "website",
        value: data.website or data.createJob.website
        }) }}

        {{ govukButton({
          text: "Save and continue"
        }) }}

        {{ saveAndFinishLater(path) }}
      </form>
      <p><a href="#">Cancel</a></p>



    </div>
  </div>

{% endblock %}
