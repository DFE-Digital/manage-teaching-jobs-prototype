
{% extends "layout.njk" %}

{% set publishDate = data.createJob and data.createJob.publishDate %}
{% set publishingToday = publishDate == 'Today (6 June 2022)' %}
{% if publishingToday %}
  {% set heading = 'Job listing published' %}
{% else %}
  {% set heading = 'Job listing scheduled' %}
{% endif %}

{% set caption = createJobCaption.createListing %}
{% set title = heading + ' - ' + caption %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
    {{ govukPanel({
      titleText: heading
    }) }}

    {% if not publishingToday and publishDate %}
      <p class="govuk-body">Your job listing will be published on {{ publishDate }} at 9am.</p>
    {% endif %}

    {% set listingJob = user.jobs and user.jobs[0] %}

    <h2 class="govuk-heading-m govuk-!-margin-top-6">Edit this job listing</h2>
    <p class="govuk-body">You can change the listing before it is published.</p>
    <ul class="govuk-list govuk-list--bullet">
      <li>
        <a class="govuk-link" href="/jobs/new/check">Change job listing details</a>
      </li>
      {% if listingJob %}
      <li>
        <a class="govuk-link" href="/jobs/{{ listingJob.id }}">View the job listing</a>
      </li>
      <li>
        <a class="govuk-link" href="/jobs/{{ listingJob.id }}/preview" target="_blank" rel="noopener noreferrer">Preview how jobseekers will see it<span class="govuk-visually-hidden"> (opens in new tab)</span></a>
      </li>
      {% endif %}
    </ul>

    <h2 class="govuk-heading-m govuk-!-margin-top-6">What you can do next</h2>
    <ul class="govuk-list govuk-list--bullet">
      <li>
        <a class="govuk-link" href="/jobs" rel="noreferrer noopener">View your job listings</a>
      </li>
      <li>
        <a class="govuk-link" href="/jobs/new/start">Create another job listing</a>
      </li>
      <li>
        <a class="govuk-link" href="/organisation">Complete your school profile</a>
      </li>
    </ul>

    </div>
  </div>
{% endblock %}