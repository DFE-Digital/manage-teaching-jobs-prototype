{% extends "layout.njk" %}

{% from "includes/create-job-save-later-button.njk" import saveAndFinishLater %}

{% set heading = 'Contract information' %}
{% set caption = createJobCaption.payAndContract %}
{% set title = heading + ' - ' + caption %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: "javascript:history.back();"
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% set fixed %}
        {{ govukInput({
          id: "createJob[fixed--length]",
          name: "createJob[fixed--length]",
          label: {
            text: "Length of contract",
            classes: "govuk-label--s"
          },
          value: data['createJob']['fixed--length']
        }) }}
      {% endset %}

      {% set maternity %}
        {{ govukInput({
          id: "createJob[maternity--length]",
          name: "createJob[maternity--length]",
          label: {
            text: "Length of contract",
            classes: "govuk-label--s"
          },
          value: data['createJob']['maternity--length']
        }) }}
      {% endset %}

      <h1 class="govuk-heading-l">
        <span class="govuk-caption-l">
          {{caption}}
        </span>
        {{heading}}
      </h1>

      <form action="/jobs/new/contract" method="post" novalidate>

        {{ govukRadios({
          idPrefix: "createJob[contract]",
          name: "createJob[contract]",
          fieldset: {
            legend: {
              text: "Contract type",
              isPageHeading: false,
              classes: "govuk-fieldset__legend--m"
            }
          },
          items: [
            {
              value: "Permanent",
              text: "Permanent",
              checked: checked("['createJob']['contract']", "Permanent")
            },
            {
              value: "Fixed term",
              text: "Fixed term",
              checked: checked("['createJob']['contract']", "Fixed term"),
              conditional: {
                html: fixed
              }
            },
            {
              value: "Maternity or parental leave cover",
              text: "Maternity or parental leave cover",
              checked: checked("['createJob']['contract']", "Maternity or parental leave cover"),
              conditional: {
                html: maternity
              }
            }
          ]
        }) }}

        {{ govukCheckboxes({
          name: "working-patterns",
          fieldset: {
            legend: {
              text: "Working patterns",
              isPageHeading: true,
              classes: "govuk-fieldset__legend--m"
            }
          },
          hint: {
            text: "Select all that apply"
          },
          items: [
            {
              value: "full time",
              text: "Full time",
              checked: checked("working-patterns", "full time") or checked("working-patterns", "Full time") or checked("['createJob']['workingPatterns']", "Full time") or checked("['createJob']['workingPatterns']", "full time")
            },
            {
              value: "part time",
              text: "Part time",
              checked: checked("working-patterns", "part time") or checked("working-patterns", "Part time") or checked("['createJob']['workingPatterns']", "Part time") or checked("['createJob']['workingPatterns']", "part time")
            }
          ]
        }) }}

        {{ govukTextarea({
          name: "moreDetail",
          id: "more-detail",
          label: {
            text: "Details of working hours/days (optional)",
            classes: "govuk-label--s",
            isPageHeading: true
          },
          hint: {
            text: "For example, 16 hours a week, Monday to Wednesday."
          },
          value: data.moreDetail
        }) }}

        {{ govukRadios({
          classes: "govuk-radios--inline",
          name: "job-share",
          fieldset: {
            legend: {
              text: "Can this role be done as a job share?",
              isPageHeading: true,
              classes: "govuk-fieldset__legend--m"
            }
          },
          hint: {
            text: "For example, can this role be filled by 2 teachers who share responsibility for the class?"
          },
          items: [
            {
              value: "yes",
              text: "Yes",
              checked: checked("job-share", "yes")
            },
            {
              value: "no",
              text: "No",
              checked: checked("job-share", "no")
            }
          ]
        }) }}
        

        {{ govukButton({
          text: "Save and continue"
        }) }}

        {{ saveAndFinishLater(path) }}
      </form>
      <p><a href="#">Cancel</a></p>



    </div>
  </div>

{% endblock %}
